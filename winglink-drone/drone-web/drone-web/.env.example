# Optional integrations. Copy to .env.local and fill in locally.
# Server-only AI credentials for the Vite development server.
# Never rename the DASHSCOPE variables to VITE_*.
DASHSCOPE_API_KEY=
DASHSCOPE_APP_ID=

# Optional legacy AMap component. This JS identifier is browser-visible.
# Leave blank for source display; never put a private key or securityJsCode here.
VITE_AMAP_JS_KEY=
